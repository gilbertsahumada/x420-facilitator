{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "x402/facilitator": ["node_modules/x402/dist/esm/facilitator"],
      "x402/types": ["node_modules/x402/dist/esm/types"]
    }
  },
  "include": ["src/**/*"]
}