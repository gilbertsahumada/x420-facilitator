# === SECRETS (usar wrangler secret put) ===
# NO poner valores reales aquí - usar wrangler secret put

# EVM_PRIVATE_KEY=0x... (configurar con: wrangler secret put EVM_PRIVATE_KEY)
# RPC_URL=https://... (configurar con: wrangler secret put RPC_URL)
# ALLOWED_ORIGINS=* (configurar con: wrangler secret put ALLOWED_ORIGINS)

# === VARIABLES PÚBLICAS ===
# Estas van en wrangler.toml [vars]

ENVIRONMENT=development
LOG_LEVEL=info
